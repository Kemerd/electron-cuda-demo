{
  "name": "geoswarm",
  "version": "0.1.0",
  "description": "Electron demo pushing native CUDA compute against WebGPU and CPU baselines: a 3D globe with drone swarms, live weather fields, and GPU particle systems.",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "vite --config vite.config.mjs",
    "build:renderer": "vite build --config vite.config.mjs",
    "build:native": "cmake-js compile --runtime=electron --runtime-version=43.2.0 --arch=x64 --directory native --out native/build",
    "rebuild:native": "cmake-js rebuild --runtime=electron --runtime-version=43.2.0 --arch=x64 --directory native --out native/build",
    "clean:native": "node -e \"require('fs').rmSync('native/build',{recursive:true,force:true})\"",
    "smoke": "npm run build:renderer && electron . --smoke-test"
  },
  "dependencies": {
    "node-addon-api": "^8.9.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "cmake-js": "^8.0.0",
    "electron": "43.2.0",
    "vite": "^8.2.0"
  }
}
